{
  "name": "netfence",
  "version": "1.1.0",
  "description": "Decky Loader plugin to block Internet and/or LAN access for Steam and games.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/androettop/netfence.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "firewall",
    "nftables"
  ],
  "author": "androettop",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.59.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
